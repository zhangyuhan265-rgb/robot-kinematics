  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 0" rpy="1.570796327 0 -1.570796327"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="500" velocity="3.926990817"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.006657813" ixy="0" ixz="0" iyy="0.006657813" iyz="0" izz="0.0045375"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0645275" rpy="0 0 0"/>
      <geometry><box size="0.145 0.12 0.12"/></geometry>
      <material name="metal_flange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.1148775" rpy="0 0 0"/>
      <geometry><cylinder radius="0.058" length="0.0318"/></geometry>
      <material name="metal_flange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.1325" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.00689"/></geometry>
      <material name="metal_flange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0645275" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.129055"/></geometry>
    </collision>
  </link>

  <!-- TCP = 法兰：与控制器 get_current_position(fd, 1, ...) 同一坐标系 -->
  <joint name="tcp_joint" type="fixed">
    <parent link="link6"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.1325" rpy="0 0 -3.141592654"/>
  </joint>

  <link name="tcp">
    <!-- 空帧也有个极小惯量：不给的话 pybullet 等后端会按 mass=1、惯量=1 顶替 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
</robot>
