    </visual>
    <visual>
      <origin xyz="-0.060734694 0.395 0" rpy="0 1.570796327 1.570796327"/>
      <geometry><box size="0.165 0.19 0.116857143"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="-0.055673469 0.507857143 0" rpy="0 1.570796327 1.481343105"/>
      <geometry><box size="0.165 0.19 0.117310188"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="-0.040489796 0.620714286 0" rpy="0 1.570796327 1.393298985"/>
      <geometry><box size="0.165 0.19 0.118658583"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="-0.015183673 0.733571429 0" rpy="0 1.570796327 1.307944271"/>
      <geometry><box size="0.165 0.19 0.120871341"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.108" length="0.23"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="0 0.79 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.22"/></geometry>
      <material name="metal_light"/>
    </visual>
    <collision>
      <origin xyz="0 0.395 0" rpy="0 1.570796327 1.570796327"/>
      <geometry><cylinder radius="0.075" length="0.79"/></geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0.79 0" rpy="0 0 1.570796327"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.268928028" upper="2.268928028" effort="500" velocity="2.596357565"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12"/>
      <inertia ixx="0.0961" ixy="0" ixz="0" iyy="0.0961" iyz="0" izz="0.0864"/>
    </inertial>
    <visual>
      <origin xyz="0.078 0 0" rpy="0 0 0"/>
      <geometry><box size="0.215 0.215 0.175"/></geometry>
      <material name="metal_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
      <geometry><cylinder radius="0.1" length="0.265"/></geometry>
      <material name="metal_dark"/>
    </visual>
    <collision>
      <origin xyz="0.078 0 0" rpy="0 0 0"/>
      <geometry><box size="0.24 0.24 0.225"/></geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.156 0 0" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.268928028" upper="2.268928028" effort="500" velocity="3.926990817"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="14"/>
      <inertia ixx="0.66885" ixy="0" ixz="0" iyy="0.66885" iyz="0" izz="0.0252"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.028125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.076" length="0.05625"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.249" rpy="0 0 0"/>
      <geometry><cylinder radius="0.062" length="0.402"/></geometry>
      <material name="metal_light"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.58425" rpy="0 0 0"/>
      <geometry><cylinder radius="0.052" length="0.285"/></geometry>
      <material name="metal_light"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.363375" rpy="0 0 0"/>
      <geometry><cylinder radius="0.062" length="0.72675"/></geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.75" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.268928028" upper="2.268928028" effort="500" velocity="1.951299785"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="6"/>
      <inertia ixx="0.0270375" ixy="0" ixz="0" iyy="0.0270375" iyz="0" izz="0.021675"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.145 0.145 0.165"/></geometry>
      <material name="metal_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.0325 0 0" rpy="0 1.570796327 0"/>
      <geometry><cylinder radius="0.075" length="0.235"/></geometry>
      <material name="metal_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
